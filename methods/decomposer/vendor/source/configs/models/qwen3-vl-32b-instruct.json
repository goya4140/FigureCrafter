{
  "model": {
    "backend": "external-json",
    "name": "QWEN_MODEL",
    "command": ["python3", "adapters/openai_compatible_vision.py"],
    "arguments": [
      "--stage", "{stage}",
      "--schema", "{schema_file}",
      "--image", "{image_file}",
      "--base-url-env", "QWEN_BASE_URL",
      "--api-key-env", "QWEN_API_KEY",
      "--model-env", "QWEN_MODEL",
      "--response-mode", "json_schema",
      "--max-tokens", "32768",
      "--image-detail", "original"
    ],
    "environment_allowlist": ["QWEN_BASE_URL", "QWEN_API_KEY", "QWEN_MODEL"],
    "timeout_seconds": 1800,
    "adapter_version": "qwen3-vl-openai-compatible-v1",
    "response_mode": "json_schema",
    "max_tokens": 32768,
    "image_detail": "original"
  }
}
